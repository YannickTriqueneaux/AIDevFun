#include <winver.h>

#define GAME_RELEASE_ENGINE_MARKER 41001

GAME_RELEASE_ENGINE_MARKER RCDATA
BEGIN
    "MAKE_YOUR_OWN_GAME_AI_ENGINE\0",
    "MakeYourOwnGame.AI\0",
    "@MAKE_YOUR_OWN_GAME_AI_VERSION@\0"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MAKE_YOUR_OWN_GAME_AI_VERSION_MAJOR@,@MAKE_YOUR_OWN_GAME_AI_VERSION_MINOR@,@MAKE_YOUR_OWN_GAME_AI_VERSION_PATCH@,0
 PRODUCTVERSION @MAKE_YOUR_OWN_GAME_AI_VERSION_MAJOR@,@MAKE_YOUR_OWN_GAME_AI_VERSION_MINOR@,@MAKE_YOUR_OWN_GAME_AI_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", "Built with MakeYourOwnGame.AI @MAKE_YOUR_OWN_GAME_AI_VERSION@\0"
            VALUE "EngineName", "MakeYourOwnGame.AI\0"
            VALUE "EngineVersion", "@MAKE_YOUR_OWN_GAME_AI_VERSION@\0"
            VALUE "FileDescription", "@GAME_PROJECT@\0"
            VALUE "FileVersion", "@MAKE_YOUR_OWN_GAME_AI_VERSION@\0"
            VALUE "OriginalFilename", "@GAME_PROJECT@.exe\0"
            VALUE "ProductName", "@GAME_PROJECT@\0"
            VALUE "ProductVersion", "@MAKE_YOUR_OWN_GAME_AI_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
